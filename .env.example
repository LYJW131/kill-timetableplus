# UIM 登录（不要把真实值提交到 Git）
XJTLU_USERNAME=
XJTLU_PASSWORD=
# 必须先在 UIM 绑定过 OTP。新绑定时扫二维码拿链接；已绑定则从密码管理器导出 otpauth URL
XJTLU_OTP_URL=otpauth://totp/...?secret=YOUR_SECRET

# TimetablePlus
TT_IDENTITY=
# 脚本真正开抢的时间（页面伪造时间只用来点出请求）
TT_TARGET_TIME=2026-09-01 08:00:00
# Enroll/Payload 查询参数，和 Network 里 URL 后面两个一致；普通课都是 false
TT_ESS_ACT=false
TT_PE_ACT=false
# 从 DevTools 里 Enroll/Payload 的 Request Payload 整段粘贴
TT_PAYLOAD={"moduleIds":["MODULE_A","MODULE_B"],"activityIds":["ACTIVITY_ID_1","ACTIVITY_ID_2"],"timestamp":0,"token":"from-browser"}
